# Verplicht: je Claude API-sleutel (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Optioneel
PORT=3000
COCO_MODEL=claude-opus-4-8

# --- Buddy Data -----------------------------------------------------------
# Waar Coco zijn columns bewaart. Staan CLIENT_ID en CLIENT_SECRET ingevuld,
# dan gaat alles naar de database; zo niet, dan valt Coco terug op
# data/history.json en blijft alles op deze ene machine staan.
#
# De sleutel maak je aan in het Buddy Data-beheerscherm bij de database "coco",
# met toegang "Lezen en schrijven". Het geheim is daarna niet meer op te vragen.
BUDDY_URL=http://localhost:5000
BUDDY_DATA_URL=http://localhost:5010
BUDDY_PROJECT=coco
# BUDDY_CLIENT_ID=bd_...
# BUDDY_CLIENT_SECRET=...

# Optioneel: laat definitieve columns óók in een gesynchroniseerde map landen.
# Wijs dit naar een lokale OneDrive/SharePoint-map die als bestandsmap in een
# MS Teams-kanaal is gekoppeld, dan verschijnt elke definitieve column
# automatisch in Teams. De database blijft de bron; dit is een kopie.
# COCO_COLUMNS_DIR=/pad/naar/Teams/Columns
# COCO_DATA_DIR=/pad/naar/data
