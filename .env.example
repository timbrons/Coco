# Verplicht: je Claude API-sleutel (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Optioneel
PORT=3000
COCO_MODEL=claude-opus-4-8

# Optioneel: laat definitieve columns in een gesynchroniseerde map landen.
# Wijs dit naar een lokale OneDrive/SharePoint-map die als bestandsmap in een
# MS Teams-kanaal is gekoppeld, dan verschijnt elke definitieve column automatisch in Teams.
# COCO_COLUMNS_DIR=/pad/naar/Teams/Columns
# COCO_DATA_DIR=/pad/naar/data
